{
  "showUi": {
    "type": "checkbox",
    "value": true,
    "text": "Show interface",
    "help": "Show or hide the title, descriptions, and interaction hint."
  },
  "headSize": {
    "type": "slider",
    "value": 100,
    "min": 55,
    "max": 160,
    "step": 5,
    "text": "Trail head size"
  },
  "trailPersistence": {
    "type": "slider",
    "value": 100,
    "min": 55,
    "max": 150,
    "step": 5,
    "text": "Trail persistence"
  },
  "effectIntensity": {
    "type": "slider",
    "value": 100,
    "min": 40,
    "max": 140,
    "step": 5,
    "text": "Effect intensity"
  },
  "glowStrength": {
    "type": "slider",
    "value": 100,
    "min": 0,
    "max": 150,
    "step": 5,
    "text": "Glow strength"
  },
  "backgroundDimming": {
    "type": "slider",
    "value": 42,
    "min": 10,
    "max": 70,
    "step": 2,
    "text": "Background dimming"
  },
  "performanceMode": {
    "type": "dropdown",
    "value": 1,
    "text": "Performance",
    "items": [
      "quality",
      "balanced",
      "low power"
    ]
  },
  "customTextSection": {
    "type": "label",
    "value": "Custom text"
  },
  "logoText": {
    "type": "textbox",
    "value": "NIGHT CITY",
    "text": "Logo",
    "help": "Maximum 40 characters."
  },
  "logoSubText": {
    "type": "textbox",
    "value": "NEON · CHROME · BLOOD",
    "text": "Subtitle",
    "help": "Maximum 80 characters."
  },
  "leftEyebrow": {
    "type": "textbox",
    "value": "WELCOME TO 2077",
    "text": "Left eyebrow",
    "help": "Maximum 50 characters."
  },
  "leftTitle": {
    "type": "textbox",
    "value": "NEON\\nSTREETS",
    "text": "Left title",
    "help": "Maximum 80 characters. Type \\n for a new line (up to 3 lines)."
  },
  "leftDesc": {
    "type": "textbox",
    "value": "In Night City, you can be anybody, do anything, as long as you're willing to pay the price. Chrome up and dive into the shadows.",
    "text": "Left description",
    "help": "Maximum 280 characters. Type \\n for a new line (up to 5 lines)."
  },
  "buttonText": {
    "type": "textbox",
    "value": "JACK IN",
    "text": "Button label",
    "help": "Maximum 24 characters."
  },
  "rightEyebrow": {
    "type": "textbox",
    "value": "CHROME AWAKENED",
    "text": "Right eyebrow",
    "help": "Maximum 50 characters."
  },
  "rightTitle": {
    "type": "textbox",
    "value": "CYBER\\nPUNK",
    "text": "Right title",
    "help": "Maximum 80 characters. Type \\n for a new line (up to 3 lines)."
  },
  "rightDesc": {
    "type": "textbox",
    "value": "A violent, vibrant metropolis where the neon never sleeps. High tech meets low life in a desperate struggle for survival.",
    "text": "Right description",
    "help": "Maximum 280 characters. Type \\n for a new line (up to 5 lines)."
  },
  "hintText": {
    "type": "textbox",
    "value": "▸ MOVE ACROSS THE SCREEN ◂",
    "text": "Interaction hint",
    "help": "Maximum 80 characters."
  }
